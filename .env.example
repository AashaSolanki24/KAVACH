# ── Backend ──────────────────────────────────────────────────────────────────
# Local development. For deployment, set NODE_ENV=production and use a public BACKEND_URL.
NODE_ENV="development"

# Create the database first: CREATE DATABASE kavach;
# Change the username/password to match your local PostgreSQL setup.
DATABASE_URL="postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/kavach"

PORT=5000

# Replace these placeholders with strong, unique random values in your local .env.
JWT_SECRET="replace-with-a-unique-random-secret"
AI_ENGINE_SECRET="replace-with-a-different-unique-random-secret"

BACKEND_URL="http://localhost:5000"

# Frontend dev servers: user app on 5173 or 5174, police dashboard on 3000.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:5174"

# ── Twilio (SMS and voice alerts) ────────────────────────────────────────────
# Leave blank to run without real SMS or calls; alerts will be logged only.
TWILIO_SID=""
TWILIO_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ── Alert Escalation Thresholds ──────────────────────────────────────────────
ALERT_SMS_THRESHOLD=50
ALERT_VOICE_CALL_THRESHOLD=75
ALERT_POLICE_THRESHOLD=85

# Dev only: optional test recipient, including country code (for example, +91XXXXXXXXXX).
DEV_TEST_EMERGENCY_PHONE=""

# ── Firebase ─────────────────────────────────────────────────────────────────
# Not needed for the current Socket.IO dispatcher flow.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY_BASE64=""

# ── AI Engine ────────────────────────────────────────────────────────────────
AI_ENGINE_URL="http://localhost:8000"

# Replace with a unique local invite code before registering a dispatcher.
DISPATCHER_INVITE_CODE="replace-with-a-local-invite-code"

LOCAL_TZ="Asia/Kolkata"